# Font (fast + clean)
font_family JetBrains Mono NL 

font_size 18.0
adjust_column_width 0
modify_font cell_height 117%

# BEGIN_KITTY_THEME
# Tokyo Night Storm
include current-theme.conf
# END_KITTY_THEME

background_opacity 0.8

# macOS-style editing
map alt+backspace send_text all \x17   
map cmd+backspace send_text all \x15  

map alt+left send_text all \x1bb     
map alt+right send_text all \x1bf   

map cmd+left send_text all \x01 
map cmd+right send_text all \x05 

# Padding around terminal content
window_padding_width 5 5

# cursor settings
# cursor_shape beam
cursor_blink_interval 0
cursor_stop_blinking_after 0

# full screen window on starting 
remember_window_size yes

macos_option_as_alt yes
enable_remote_control yes

# Vim-style pane navigation (not using ctrl to avoid conflict with nvim)
map alt+h neighboring_window left
map alt+j neighboring_window down
map alt+k neighboring_window up
map alt+l neighboring_window right

# Tab navigation with Shift + Arrow
map shift+left previous_tab
map shift+right next_tab

# tab title name
tab_title_template "{index}: {title[title.rfind('/')+1:]}" 
# tab_title_template "{index}: {tab.active_wd.split('/')[-1]}"

# control kitty from scripts / shell commands
allow_remote_control yes

# fuzzy tab picker
map option+space launch --type=overlay ~/.local/bin/kitty_tabs

# tab bar
tab_bar_edge bottom
tab_bar_style fade

# macos specific config
# macos_titlebar_color background
hide_window_decorations yes
map cmd+t new_tab_with_cwd

# setting editor
editor nvim

# cursor trail setting
# cursor_trail 3
# cursor_trail_start_threshold 2
# cursor_trail_decay 0.1 0.4

